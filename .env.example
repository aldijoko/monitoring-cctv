# Public API base — proxied by Vite to backend in dev
PUBLIC_API_BASE=/api/v1

# Server-only: base URL the SvelteKit server itself calls directly (load
# functions/form actions — see src/lib/server/api.ts, src/routes/login).
# Not proxied by Vite, so it needs the full backend URL including /api/v1.
API_BASE_URL=http://localhost:8000/api/v1
